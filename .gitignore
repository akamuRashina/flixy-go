.env
.env.local
.env.*.local
.env.production
.env.development
.env.staging

# API Keys & Secrets
config/secrets.js
config/credentials.json
api-keys.json

# ───────────────────────────────────────────────────────────────
#  📦 NODE.JS
# ───────────────────────────────────────────────────────────────
# Dependencies
node_modules/
jspm_packages/

# npm
npm-debug.log*
npm-error.log*
package-lock.json.backup

# Yarn
yarn-debug.log*
yarn-error.log*
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# pnpm
pnpm-debug.log*

# ───────────────────────────────────────────────────────────────
#  🗄️ DATABASES
# ───────────────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
*.log
*.dump

# ───────────────────────────────────────────────────────────────
#  📝 LOGS
# ───────────────────────────────────────────────────────────────
logs/
*.log
*.log.*
combined.log
error.log

# ───────────────────────────────────────────────────────────────
